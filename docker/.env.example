# L8：docker-compose 变量模板。复制为 docker/.env 后再改（.env 已被 .gitignore 忽略）。
#   cp docker/.env.example docker/.env

# ---- 必填（不填则 compose 直接报错，避免用弱默认值起生产栈）----
# MySQL root 口令，同时用于后端 hm.db.pw
HM_DB_PW=change-me
# /inner/** 内部调用共享密钥（对应 H3），请用足够长的随机串
HM_INTERNAL_TOKEN=change-me-too
# 密钥库口令（对应 H4；仓库内 litemall.jks 的口令为 hmall123，生产请换掉）
HM_JKS_PASSWORD=hmall123

# ---- 可选 ----
# dev：走各模块 application-dev.yaml，可从 Nacos 缺配置启动（推荐先跑通）
# prod：强制从 Nacos 导入 ${spring.application.name}.yaml，缺失即启动失败
HM_ACTIVE_PROFILE=dev

HM_DB_NAME=litemall
HM_DB_USER=root

# L7 文件上传
HM_STORAGE_MAX_SIZE=10485760
HM_STORAGE_ALLOWED_EXT=jpg,jpeg,png,gif,webp,bmp,pdf

# 日志级别（对应 M12 的 HM_LOG_LEVEL_APP）
HM_LOG_LEVEL_APP=DEBUG

# ---- 非 compose 变量，仅作提示 ----
# 本机运行时（不走 compose）常用的中间件地址：
#   HM_NACOS_ADDR=192.168.96.129:8848
#   HM_SEATA_ADDR=192.168.96.129:8848   # Seata registry 走 Nacos，故是 8848 不是 8091
#   HM_ROCKETMQ_ADDR=192.168.96.129:9876
# compose 内部会覆盖为服务名（nacos:8848 / rocketmq-namesrv:9876），无需在此设置。
#
# *.jks 被 .gitignore 忽略：compose 需要 ./secrets/litemall.jks，请自行放置
#   backend/litemall-next/litemall-gateway/src/main/resources/litemall.jks
#   backend/litemall-next/litemall-admin/src/main/resources/litemall.jks
#   backend/litemall-next/litemall-user/src/main/resources/litemall.jks
# （三份内容相同，取任意一份即可）