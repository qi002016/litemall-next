# =============================================================
# mobile-agent 环境变量示例：复制为 .env 后按需修改
# 密钥只放 .env（.gitignore 已忽略），本文件不写任何明文密钥
# =============================================================

# ---- LLM（Agent 大脑）----
# provider: mock=本地规则模拟（无需 Key，离线可跑）
#           ark=火山方舟（OpenAI 兼容协议）
#           deepseek=DeepSeek V4.1 Flash（OpenAI 兼容协议）
LLM_PROVIDER=mock
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
LLM_TEMPERATURE=0.2

# ---- DeepSeek V4.1 Flash（P1）----
# 官方 API 调用名是 deepseek-flash（对应 DeepSeek-V4.1-Flash-1017，V4.1 Flash）；
# 旧名 deepseek-v4-flash 虽兼容但会路由到新版，一律不要用。
# 坑：DeepSeek 默认开 thinking，thinking 模式下 tool_choice:"required" 返回 400、
# temperature 无效；代码已在所有链路显式传 extra_body={"thinking":{"type":"disabled"}}。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- 商城 Java 网关（工具执行层）----
MALL_BASE_URL=http://127.0.0.1:8000
# tool_fallback: mock=工具返回演示数据（独立开发阶段）| remote=调用 Java 网关真实接口
TOOL_FALLBACK=mock

# ---- 会话记忆（可选 Redis；不配则用进程内存，重启丢失）----
REDIS_URL=

# ---- checkpointer 持久化（P1 ③）----
# auto=自动取可用实现（默认：本地 JSON 文件 saver，重启可读、零新增依赖）
# sqlite=官方 SqliteSaver（需先隔离安装，见 requirements.txt；版本冲突时自动降级）
# redis | memory（memory 显式关闭持久化，仅调试用）
# P1 明确不引入 PostgreSQL / Milvus。
CHECKPOINT_BACKEND=auto
# 持久化文件目录，留空=项目根目录
CHECKPOINT_DIR=

# ---- 服务 ----
AGENT_HOST=127.0.0.1
AGENT_PORT=8100
# 与 app/config.py 读取的变量名保持一致（RATE_LIMIT，不是 RATE_LIMIT_PER_MIN）；默认 30 次/分钟
RATE_LIMIT=30
SESSION_TTL=86400
