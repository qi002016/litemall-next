<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.litemall</groupId>
        <artifactId>litemall-next</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>litemall-common</artifactId>
    <!-- M16：拆分后本模块不再含任何代码，降为纯 POM 聚合层 -->
    <packaging>pom</packaging>
    <name>litemall-common</name>
    <description>
        M16：公共依赖聚合层（纯 POM）。原先所有代码与依赖都堆在本模块，导致 WebFlux 网关
        为了拿到 4 个类而必须写 7 项 exclusion；现拆为 5 个单一职责模块，本模块只做聚合，
        业务服务依赖本模块即获得全套基础能力（依赖树与拆分前一致）。
        网关不再依赖本模块，改为只依赖 litemall-common-core + litemall-common-jwt，
        因此不需要任何 exclusion。
    </description>

    <dependencies>
        <!-- 5 个拆分层 -->
        <dependency>
            <groupId>com.litemall</groupId>
            <artifactId>litemall-common-core</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.litemall</groupId>
            <artifactId>litemall-common-web</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.litemall</groupId>
            <artifactId>litemall-common-mybatis</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.litemall</groupId>
            <artifactId>litemall-common-cache</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.litemall</groupId>
            <artifactId>litemall-common-notify</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!--
            以下中间件不属于任何单个代码层的职责，而是**所有业务服务共同的运行时前提**
            （每个服务都要注册到 Nacos、从 Nacos 配置中心取配置、参与 Seata 全局事务、
            经 OpenFeign+OkHttp 互调、用 RocketMQ 发消息），故保留在聚合层。
            网关依赖的是 common-core，不经过本模块，因此不会被这些依赖牵连。
        -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-seata</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-okhttp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.1</version>
        </dependency>
    </dependencies>
</project>