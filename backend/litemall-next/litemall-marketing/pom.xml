<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.litemall</groupId>
        <artifactId>litemall-next</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>litemall-marketing</artifactId>
    <name>litemall-marketing</name>
    <description>litemall-marketing</description>
    <dependencies>
        <!-- 公共依赖聚合:Web / MyBatis-Plus / MySQL / Redis / Nacos / Sentinel / Seata 统一由 common 提供 -->
        <dependency>
            <groupId>com.litemall</groupId>
            <artifactId>litemall-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Feign 接口与公共 DTO -->
        <dependency>
            <groupId>com.litemall</groupId>
            <artifactId>litemall-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>
    <build>
        <!-- L8：业务模块同样需要可执行 jar，否则镜像里 java -jar 起不来（此前只有网关声明了本插件）。
             库模块 litemall-common / litemall-common-jwt / litemall-api 不得声明，保持普通 jar。 -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>