<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.litemall</groupId>
        <artifactId>litemall-next</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>litemall-common-mybatis</artifactId>
    <name>litemall-common-mybatis</name>
    <description>
        M16：common 拆分层之一——数据访问层。内容：MyBatisConfig(分页插件)、分页出参 PageVO、
        分页入参 PageQuery 与 MySQL 驱动。网关此前需要排除 mybatis-plus / jsqlparser /
        mysql-connector-j，拆分后这些依赖只存在于本模块，网关自然拿不到。
        说明：PageVO/PageQuery 都依赖 MyBatis-Plus 的 Page，故与数据访问同层，
        而不是放在 common-web（避免 web 层反向依赖数据访问）。
        注意：@Schema 直接依赖 swagger-annotations（而非 knife4j starter），
        以免数据访问层反向拖入 Servlet Web。
    </description>

    <dependencies>
        <!-- PageVO 依赖 BeanUtils/CollUtils/Convert -->
        <dependency>
            <groupId>com.litemall</groupId>
            <artifactId>litemall-common-core</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- MySQL 驱动（版本由 Boot BOM 管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!-- PageQuery 上的 @Schema（2.2.47 与 knife4j 5.7.5 内部一致） -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.47</version>
        </dependency>
        <!-- PageQuery 使用 StrUtil -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!-- PageQuery 的分页参数上有 @Min 约束 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>
</project>