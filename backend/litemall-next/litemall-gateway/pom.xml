<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.litemall</groupId>
		<artifactId>litemall-next</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>litemall-gateway</artifactId>

	<properties>
		<maven.compiler.source>25</maven.compiler.source>
		<maven.compiler.target>25</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencies>
		<!-- M11：JWT 单一实现（JwtTool/JwtProperties/KeyPair 自动装配） -->
		<dependency>
			<groupId>com.litemall</groupId>
			<artifactId>litemall-common-jwt</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<!--
			M16：common 拆分后，网关只依赖核心层，**不再需要任何 exclusion**。
			原先为了拿到 TokenPrincipal/ForbiddenException/UnauthorizedException/InnerApiProperties
			四个类，必须从 litemall-common 排除 Servlet Web / 数据访问 / Redis / 文档 UI / Seata 共 8 项；
			现在这些依赖分别落在 common-web / common-mybatis / common-cache，网关不依赖它们即可。
		-->
		<dependency>
			<groupId>com.litemall</groupId>
			<artifactId>litemall-common-core</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<!--
			nacos-config 是网关**自己**要用的：application.yaml 里写了
			spring.config.import: (optional:)nacos:${spring.application.name}.yaml。
			拆分前它是经 litemall-common 传递进来的，属于隐式依赖；这里显式声明。
		-->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
		</dependency>
		<!-- 网关(WebFlux) -->
		<!--网关-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>
		<!--nacos discovery-->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
		</dependency>
		<!--负载均衡-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-loadbalancer</artifactId>
		</dependency>
	</dependencies>

	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
